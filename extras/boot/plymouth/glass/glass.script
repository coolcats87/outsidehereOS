// Glass boot splash: black, centred white logo, a thin capsule progress bar that eases forward.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

// Logo: ~11% of the screen height, a little above centre
logo_src = Image("logo.png");
logo_h = Math.Int(sh * 0.11);
logo_img = logo_src.Scale(logo_h, logo_h);
logo = Sprite(logo_img);
logo.SetX(Math.Int(sw / 2 - logo_h / 2));
logo.SetY(Math.Int(sh / 2 - logo_h * 0.85));
logo.SetZ(10);
logo_opacity = 0;
logo.SetOpacity(0);

// Progress bar under it
bar_w = Math.Int(sh * 0.19);
bar_h = Math.Int(sh * 0.0055);
if (bar_h < 4) bar_h = 4;
bar_x = Math.Int(sw / 2 - bar_w / 2);
bar_y = Math.Int(sh / 2 + logo_h * 0.75);

track_src = Image("track.png");
fill_src = Image("fill.png");
track = Sprite(track_src.Scale(bar_w, bar_h));
track.SetPosition(bar_x, bar_y, 10);
track.SetOpacity(0);
fill = Sprite();
fill.SetPosition(bar_x, bar_y, 11);

target = 0;
shown = 0;
last_w = -1;

fun boot_progress_cb(duration, progress) {
    if (progress > target) target = progress;
}
Plymouth.SetBootProgressFunction(boot_progress_cb);

fun refresh_cb() {
    // fade the logo and bar in over ~half a second
    if (logo_opacity < 1) {
        logo_opacity = logo_opacity + 0.04;
        if (logo_opacity > 1) logo_opacity = 1;
        logo.SetOpacity(logo_opacity);
        track.SetOpacity(logo_opacity);
        fill.SetOpacity(logo_opacity);
    }
    // ease the fill towards the reported progress
    shown = shown + (target - shown) * 0.08;
    w = Math.Int(bar_w * shown);
    if (w < bar_h) w = bar_h;
    if (w != last_w) {
        fill.SetImage(fill_src.Scale(w, bar_h));
        last_w = w;
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

// Password prompt (only used if a disk ever asks for one): bullets under the bar
prompt = Sprite();
bullets = Sprite();
fun display_password_cb(prompt_text, bullet_count) {
    prompt.SetImage(Image.Text(prompt_text, 1, 1, 1, 0.8));
    prompt.SetPosition(Math.Int(sw / 2 - prompt.GetImage().GetWidth() / 2), bar_y + bar_h * 6, 20);
    s = "";
    for (i = 0; i < bullet_count; i++) s += "• ";
    bullets.SetImage(Image.Text(s, 1, 1, 1, 1));
    bullets.SetPosition(Math.Int(sw / 2 - bullets.GetImage().GetWidth() / 2), bar_y + bar_h * 11, 20);
}
fun display_normal_cb() {
    prompt.SetImage(Image.Text("", 0, 0, 0, 0));
    bullets.SetImage(Image.Text("", 0, 0, 0, 0));
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);
Plymouth.SetDisplayNormalFunction(display_normal_cb);

// Messages from boot are hidden, like on a Mac
fun message_cb(text) { }
Plymouth.SetMessageFunction(message_cb);
